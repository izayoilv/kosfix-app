{
  "name": "kosfix-app",
  "version": "1.0.1",
  "main": "index.ts",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "start": "expo start",
    "android": "bash scripts/android.sh",
    "android:device": "bash scripts/android.sh --device",
    "prebuild": "expo prebuild --clean",
    "build:apk": "bash scripts/build-apk.sh",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "expo": "~58.0.26",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-notifications": "~58.1.9",
    "expo-splash-screen": "~58.0.15",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-paper": "^5.15.5",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@expo/config-plugins": "58.0.13",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "jest": "30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "3.10.1",
    "test-renderer": "1.3.1",
    "typescript": "~6.0.3"
  }
}
